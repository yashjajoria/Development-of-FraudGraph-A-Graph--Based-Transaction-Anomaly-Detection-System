# DATABASE_URL comes from `neon deploy` (.env.local). Put secrets below in backend/.env
APP_ENV=dev                # production refuses default secrets
JWT_SECRET=               # long random string
DEMO_PASSWORD=            # password for demo users analyst|admin|viewer
CORS_ORIGINS=http://localhost:5173
LLM_PROVIDER=groq        # groq | gemini | ollama | mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
